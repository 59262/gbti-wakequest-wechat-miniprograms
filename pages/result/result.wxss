.result-page {
  --accent: #5C8574;
}

.result-hero {
  position: relative;
  padding: 32rpx 30rpx 36rpx;
  overflow: hidden;
}

.result-hero__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.result-hero__code {
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 950;
}

.hidden-mark {
  position: absolute;
  right: 28rpx;
  top: 88rpx;
  z-index: 2;
  width: 150rpx;
  height: 150rpx;
  border: 4rpx solid rgba(102, 135, 119, 0.42);
  border-radius: 50%;
  background: rgba(231, 239, 234, 0.86);
  color: #668777;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: rotate(10deg);
  box-shadow: 0 12rpx 28rpx rgba(32, 50, 44, 0.08);
}

.hidden-mark::before {
  content: "";
  position: absolute;
  inset: 10rpx;
  border: 2rpx dashed rgba(102, 135, 119, 0.38);
  border-radius: 50%;
}

.hidden-mark__serial {
  position: relative;
  font-size: 20rpx;
  font-weight: 950;
}

.hidden-mark__label {
  position: relative;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 950;
}

.result-hero__name {
  display: block;
  margin-top: 12rpx;
  color: #26312E;
  font-size: 52rpx;
  font-weight: 950;
  line-height: 1.15;
}

.result-hero__category {
  display: block;
  margin-top: 16rpx;
  color: #68736F;
  font-size: 25rpx;
  font-weight: 700;
}

.result-hero__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 28rpx;
}

.result-hero__tags text {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(92, 133, 116, 0.12);
  color: #5C8574;
  font-size: 22rpx;
  font-weight: 850;
}

.quote-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-color: rgba(102, 135, 119, 0.18);
  background: #FFFFFF;
}

.quote-card text {
  color: #20322C;
  font-size: 32rpx;
  font-weight: 780;
  line-height: 1.55;
}

.report-card {
  padding: 28rpx;
}

.behavior {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.behavior + .behavior {
  margin-top: 22rpx;
}

.behavior__dot {
  flex: 0 0 auto;
  width: 16rpx;
  height: 16rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: var(--accent);
}

.behavior__text,
.analysis {
  color: #26312E;
  font-size: 28rpx;
  line-height: 1.62;
}

.match-grid {
  display: grid;
  gap: 18rpx;
}

.match-card {
  padding: 26rpx;
}

.match-card__label {
  display: block;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 900;
}

.match-card__name {
  display: block;
  margin-top: 12rpx;
  color: #26312E;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.match-card__code {
  display: block;
  margin-top: 8rpx;
  color: #68736F;
  font-size: 22rpx;
  font-weight: 900;
}

.match-card__reason {
  display: block;
  margin-top: 14rpx;
  color: #68736F;
  font-size: 25rpx;
  line-height: 1.5;
}

.result-actions {
  display: grid;
  gap: 18rpx;
  margin-top: 42rpx;
}

.result-disclaimer {
  margin-top: 24rpx;
  color: #8C9692;
  font-size: 22rpx;
  line-height: 1.55;
  text-align: center;
}

.share-canvas {
  position: fixed;
  left: -2000px;
  top: -2000px;
  pointer-events: none;
}
