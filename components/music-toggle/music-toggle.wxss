.music-toggle {
  position: fixed;
  right: 28rpx;
  top: calc(28rpx + env(safe-area-inset-top));
  z-index: 30;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  color: #668777;
  border: 2rpx solid rgba(102, 135, 119, 0.22);
  box-shadow: 0 10rpx 28rpx rgba(32, 50, 44, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.music-toggle text {
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1;
}

.music-toggle.is-off {
  color: #9AA39F;
  border-color: rgba(154, 163, 159, 0.22);
}
