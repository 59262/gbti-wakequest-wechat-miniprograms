.species {
  position: relative;
  width: 360rpx;
  height: 300rpx;
  margin: 0 auto;
  --species-color: #5C8574;
}

.species__image {
  position: absolute;
  left: 0;
  top: -22rpx;
  width: 100%;
  height: 344rpx;
}

.species__halo {
  position: absolute;
  left: 34rpx;
  top: 42rpx;
  width: 292rpx;
  height: 198rpx;
  border-radius: 56rpx;
  background: var(--species-color);
  opacity: 0.14;
  transform: rotate(-5deg);
}

.species__body {
  position: absolute;
  left: 84rpx;
  top: 44rpx;
  width: 196rpx;
  height: 214rpx;
  border-radius: 88rpx 76rpx 82rpx 74rpx;
  background: var(--species-color);
  box-shadow: 0 24rpx 44rpx rgba(38, 49, 46, 0.14);
  transform: rotate(4deg);
}

.species__facet {
  position: absolute;
  background: rgba(255, 255, 255, 0.38);
}

.facet-a {
  left: 34rpx;
  top: 28rpx;
  width: 90rpx;
  height: 94rpx;
  border-radius: 28rpx 18rpx 36rpx 20rpx;
  transform: rotate(18deg);
}

.facet-b {
  right: 28rpx;
  bottom: 38rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx 30rpx 20rpx 26rpx;
  background: rgba(255, 255, 255, 0.22);
  transform: rotate(-18deg);
}

.species__eye {
  position: absolute;
  top: 92rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #26312E;
}

.eye-left {
  left: 68rpx;
}

.eye-right {
  right: 68rpx;
}

.species__mouth {
  position: absolute;
  left: 80rpx;
  top: 124rpx;
  width: 42rpx;
  height: 22rpx;
  border-bottom: 5rpx solid #26312E;
  border-radius: 0 0 40rpx 40rpx;
}

.species__chip {
  position: absolute;
  border-radius: 999rpx;
  background: var(--species-color);
  opacity: 0.42;
}

.chip-a {
  left: 30rpx;
  top: 110rpx;
  width: 58rpx;
  height: 28rpx;
  transform: rotate(-22deg);
}

.chip-b {
  right: 36rpx;
  top: 92rpx;
  width: 46rpx;
  height: 46rpx;
}

.chip-c {
  right: 70rpx;
  bottom: 34rpx;
  width: 72rpx;
  height: 24rpx;
  transform: rotate(15deg);
}

.species.is-hidden .species__halo {
  opacity: 0.25;
  transform: rotate(5deg) scale(1.08);
}
