.progress {
  width: 100%;
}

.progress__meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
  color: #68736F;
  font-size: 22rpx;
  font-weight: 700;
}

.progress__track {
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(92, 133, 116, 0.12);
}

.progress__fill {
  height: 100%;
  border-radius: 999rpx;
  background: #5C8574;
  transition: width 260ms ease;
}
